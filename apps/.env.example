# Poetry PostgreSQL.
POETRY_DB_USER=poetry_user
POETRY_DB_PASSWORD=replace-with-a-random-database-password
POETRY_DB_NAME=dreamlyn_poetry

# URL-encode reserved characters from POETRY_DB_PASSWORD in this URL.
POETRY_DATABASE_URL=postgresql+asyncpg://poetry_user:replace-with-a-random-database-password@app-poetry-postgres:5432/dreamlyn_poetry

# Poetry authentication and administration.
POETRY_JWT_SECRET=replace-with-at-least-32-random-bytes
POETRY_JWT_ALGORITHM=HS256
POETRY_ACCESS_TOKEN_MINUTES=15
POETRY_REFRESH_TOKEN_DAYS=30
POETRY_REFRESH_COOKIE_NAME=poetry_refresh_token
POETRY_REFRESH_COOKIE_DOMAIN=.example.com
POETRY_REFRESH_COOKIE_SECURE=true
POETRY_REFRESH_COOKIE_SAMESITE=lax
POETRY_ADMIN_DOCS_USERNAME=admin
POETRY_ADMIN_DOCS_PASSWORD=replace-with-a-random-admin-password

# Poetry browser/API contract. Keep the JSON list syntax.
POETRY_CORS_ALLOWED_ORIGINS=["https://poetry.example.com"]

# Existing Dreamlyn AI stack.
POETRY_LITELLM_BASE_URL=http://litellm-master:4000
POETRY_LITELLM_MODEL=timur
POETRY_GENERATION_TIMEOUT_SECONDS=300
POETRY_S3_DOWNLOAD_TIMEOUT_SECONDS=120
POETRY_GENERATION_MIN_DURATION_SECONDS=5
POETRY_GENERATION_MAX_DURATION_SECONDS=30
POETRY_GENERATION_MAX_PROMPT_LENGTH=4000
