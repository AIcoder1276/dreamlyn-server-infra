server:
  address: 'tcp://0.0.0.0:9091/'

authentication_backend:
  file:
    path: /config/data/users_database.yml

storage:
  encryption_key: "{very_very_long_string_for_encryption_purposes}"
  local:
    path: /config/data/db.sqlite3

access_control:
  default_policy: deny
  rules:
    - domain: "{sub_domain}.{domain}.{domain_zone}"
      policy: two_factor

session:
  name: authelia_session
  secret: "{very_long_string_with_numbers}"
  expiration: 3600
  cookies:
    - domain: "{domain}.{domain_zone}"
      authelia_url: "https://auth.{domain}.{domain_zone}"

notifier:
  filesystem:
    filename: /config/notification.txt

identity_validation:
  reset_password:
    jwt_secret: "{another_very_long_string}"

default_2fa_method: "totp"
totp:
  issuer: "{some_name}"
