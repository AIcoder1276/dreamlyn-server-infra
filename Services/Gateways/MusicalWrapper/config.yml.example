musicgen_api_base: http://ai-music-musicgen_small:8000

s3:
  endpoint: http://swfs-s3:8333
  region: us-east-1
  bucket: dreamlyn-music
  prefix: musicgen
  public_base_url: http://s3.dreamlyn.ru
  access_key_env: STORAGE_MUSIC_USER_LOGIN
  secret_key_env: STORAGE_MUSIC_USER_PASSWORD

folders:
  logs: /app/Logs

generation:
  duration_seconds:
    min: 5
    max: 7
    default: 6
  default_format: wav
