# Reject unknown hosts on both ports.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 444;
}

# Redirect every configured host to HTTPS.
server {
    listen 80;
    server_name
        ${DOMAIN}
        auth.${DOMAIN}
        storage.${DOMAIN}
        s3.${DOMAIN}
        attu.${DOMAIN}
        api-milvus.${DOMAIN}
        track.${DOMAIN}
        api-ai.${DOMAIN}
        poetry.${DOMAIN}
        api-poetry.${DOMAIN}
        admin-poetry.${DOMAIN}
	asr.${DOMAIN};

    return 301 https://$host$request_uri;
}

# Authelia.
server {
    listen 443 ssl;
    server_name auth.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/service-unavailable.conf;

    location / {
        set $authelia_upstream authelia:9091;
        proxy_pass http://$authelia_upstream;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
    }
}

# SeaweedFS filer.
server {
    listen 443 ssl;
    server_name storage.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/service-unavailable.conf;
    error_page 401 =302 $scheme://auth.${DOMAIN}/?rd=$scheme://$http_host$request_uri;

    location / {
        auth_request /authelia;

        set $filer_upstream swfs-filer:8888;
        proxy_pass http://$filer_upstream;
        proxy_set_header Cookie $cleaned_cookies;
        proxy_set_header Host $http_host;
    }

    location = /authelia {
        internal;
        set $authelia_verify_upstream authelia:9091;
        proxy_pass http://$authelia_verify_upstream/api/verify;
        proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
    }
}

