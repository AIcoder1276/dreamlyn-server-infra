# SeaweedFS S3 API. Use a Docker DNS name internally or the nginx HTTPS URL externally.
S3_ENDPOINT_URL=0
S3_ACCESS_KEY_ID=1
S3_SECRET_ACCESS_KEY=2
# S3_BUCKET, S3_PREFIX, S3_REGION, and S3_VERIFY_TLS override config.yml when set.

LITELLM_API_URL=3
LITELLM_API_KEY=4
LITELLM_EMBEDDING_MODEL_PROVIDER=5
LITELLM_EMBEDDING_MODEL_ID=6

MILVUS_API_URL=7
MILVUS_TOKEN=8
MILVUS_DB=9
MILVUS_COLLECTION=10

INGESTION_API_TOKEN=11
# SERVICE_HOST, SERVICE_PORT, SYNC_INTERVAL_SECONDS, CHUNK_SIZE, CHUNK_OVERLAP,
# EMBEDDING_BATCH_SIZE, SYNC_SUPPORTED_EXTENSIONS, and INGESTION_NAMESPACE are optional overrides.
